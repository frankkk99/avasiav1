# Comma-separated HTTPS hosts that the admin HLS tester may request.
ALLOWED_HLS_HOSTS=helvid.com

# Keep false on public deployments. Enable only for local/private playback testing.
ENABLE_STREAM_PROXY=false

# Optional override for upstream requests.
# HLS_TEST_USER_AGENT=Mozilla/5.0 ...

# HMAC secret for short-lived playback sessions. Set a strong random value in production.
PLAYBACK_SESSION_SECRET=replace-with-a-long-random-secret

# Session lifetime in seconds (30–1800).
PLAYBACK_SESSION_TTL_SECONDS=300

# Server-side persistence for the admin tools. The anon key is safe to send only to the Edge Function;
# never expose a service role/secret key to the browser.
ALPHALABHUB_SUPABASE_URL=https://qlunnckudeynhruxzpnb.supabase.co
ALPHALABHUB_SUPABASE_ANON_KEY=replace-with-alphalab-hub-anon-key
ALPHALABHUB_SUPABASE_FUNCTION_URL=https://qlunnckudeynhruxzpnb.supabase.co/functions/v1/avasi-admin-store
# Optional: direct server-side REST fallback, never expose this value publicly.
# ALPHALABHUB_SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
